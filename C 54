
typedef struct Node{
    int val;
    struct Node*next; 
} node;

typedef struct{
    node* front;
    node* rear;
    int size;
} Queue;


Queue* createQ(){
    Queue* q=malloc(sizeof(Queue));
    q->front=NULL;
    q->rear=NULL;
    q->size=0;
    return q;
}

void enqueue(Queue*q,int x){
    node* newNode=malloc(sizeof(node));
    newNode->val=x;
    newNode->next=NULL;
    if(q->rear)q->rear->next=newNode;
    q->rear=newNode;
    if(!q->front)q->front=newNode;
    q->size++;
}

int dequeue(Queue*q){
    if(!q->front)return -1;
    node *temp=q->front;
    int val=temp->val;
    q->front=temp->next;
    if(!q->front)q->rear=NULL;
    free(temp);
    q->size--;
    return val;
}

int peek(Queue*q){
    return (q->front)?q->front->val:-1;
}

bool isEmptyQueue(Queue*q){
    return q->size==0;
}

typedef struct {
    Queue* q;
} MyStack;

MyStack* myStackCreate() {
    MyStack *obj=malloc(sizeof(MyStack));
    obj->q=createQ();
    return obj;
}

void myStackPush(MyStack* obj, int x) {
    enqueue(obj->q,x);

    for(int i=0;i<obj->q->size-1;i++){
        enqueue(obj->q,dequeue(obj->q));
    }
}

int myStackPop(MyStack* obj) {
    return dequeue(obj->q);
}

int myStackTop(MyStack* obj) {
    return peek(obj->q);
}

bool myStackEmpty(MyStack* obj) {
    return isEmptyQueue(obj->q);
}

void myStackFree(MyStack* obj) {
    free(obj->q);
    free(obj);
}

