int compare(const void* a,const void* b){
    int x = *(const int*)a;
    int y = *(const int*)b;
    if(x<y){
        return -1;
    }
    if(x>y){
        return 1;
    }
    return 0;
}
int findLHS(int* nums, int numsSize) {
    qsort(nums,numsSize,sizeof(int),compare);
    int res = 0;
    int t = 0;
    int e = 0;
    for(int i=0;i<numsSize-1;i++){
        int n = 1;
        while(n<numsSize-i){
            if(nums[i]==nums[i+n]){
                t++;
            }
            else
            if(nums[i]-nums[i+n]==-1){
                t++;
                e = 1;
            }
            else{
                break;
            }
            n++;
        }
        if(t>res && e==1){
            res = t;
        }
        t = 0;
        e = 0;
        n = 0;
    }
    if(res==0){
        return res;
    }
    return ++res;
}
